programa
{
	
	funcao inicio()
	{
		inteiro senha

		escreva("Qual a sua senha?:  ")
		leia(senha)

		se(senha>=25 e senha<=49) {escreva("Guichê A")
		}
		senao se(senha>=50 e senha<=74) {escreva("Guichê B")
		}
		senao se(senha >=47 e senha <=90) {escreva("Guichê C")
		}
		senao{escreva ("Guichê D ou E")
		}
	}
}
