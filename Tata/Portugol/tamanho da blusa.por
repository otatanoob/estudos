programa
{
	
	funcao inicio()
	{
		caracter tamanho
		
		escreva("Qual o tamanho da blusa solocitada:  ")
		leia(tamanho)

		escolha(tamanho)
		{
			caso 'P':
				escreva("P: 0,46 x 0,55")
				pare
			caso 'M':
				escreva("M: 0,51 x 0,56")
				pare
			caso 'G':
				escreva("G: 0,52 x 0,58")
				pare
			caso 'p':
				escreva("P: 0,46 x 0,55")
				pare
			caso 'm':
				escreva("M: 0,51 x 0,56")
				pare
			caso 'g':
				escreva("G: 0,52 x 0,58")
				pare
			caso contrario:
				escreva("Tamanho inválido")
				pare
		}
	}
}
