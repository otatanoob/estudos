programa
{
	
	funcao inicio()
	{
		caracter letra
		
		escreva("Escreva uma letra:  ")
		leia(letra)
		
		escolha(letra)
		{
			caso 'a':
				escreva("Essa letra é uma vogal  ")
				pare
			caso 'e':
				escreva("Essa letra é uma vogal  ")
				pare
			caso 'i':
				escreva("Essa letra é uma vogal  ")
				pare
			caso 'o':
				escreva("Essa letra é uma vogal  ")
				pare
			caso 'u':
				escreva("Essa letra é uma vogal  ")
				pare
			caso 'A':
				escreva("Essa letra é uma vogal  ")
				pare
			caso 'E':
				escreva("Essa letra é uma vogal  ")
				pare
			caso 'I':
				escreva("Essa letra é uma vogal  ")
				pare
			caso 'O':
				escreva("Essa letra é uma vogal  ")
				pare
			caso 'U':
				escreva("Essa letra é uma vogal  ")
				pare
			caso contrario:
				escreva("Essa letra é uma consoante  ")
				pare
		}
	}
}
