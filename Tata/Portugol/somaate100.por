programa
{
	
	funcao inicio()
	{
	inteiro numero, soma=0, i=0
		faca{
			escreva("Digite um número: ")
			leia(numero)

			soma+=numero
			i++
			
		}enquanto(soma<=100)
		escreva("\nO valor do soma foi: ",soma,"\nE a quantidade de números foi: ",i)
	}
}
