programa
{
    funcao inicio()
    {
        real a, b // Declara duas variáveis reais: a e b

        escreva("insira o primeiro numero") // Exibe mensagem para inserir o primeiro número
        leia(a) // Lê o primeiro número e armazena em a

        escreva("insira o segundo numero") // Exibe mensagem para inserir o segundo número
        leia(b) // Lê o segundo número e armazena em b

        //0-10.00 // Linha de comentário (não afeta o código)
        //b-5.00 // Linha de comentário (não afeta o código)

        escreva(a + b) // Calcula a soma de a e b e exibe o resultado
    }
}
